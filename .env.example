# ==========================================
# QRVerse Environment Variables Configuration
# ==========================================

# Production App URL (e.g. https://qrverse.vercel.app or http://localhost:3000 in dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase PostgreSQL Database (Prisma ORM Connection)
# Get from Supabase Project Settings -> Database -> Connection String (Pooled & Direct)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgboiler=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase Public API Credentials & Storage
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Supabase Private Service Role Key (Server-side ONLY)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
